set TIMING_MARGIN 1.0

if {$DIR_TYPE == "TX"} {

    set axis_vid_clk_period     [expr {1000.0 / ( ($LINE_RATE * $NUM_LANE) / ($PIXELS_PER_CLOCK * $PIX_WIDTH) ) / $TIMING_MARGIN}]
    if {$speed == "9_High-Performance_1.0V" || $speed == "9_Low-Power_1.0V"} {
        set axis_vid_clk_period_max [expr {5.333333 / $TIMING_MARGIN}]
    } elseif {$speed == "8_High-Performance_1.0V" || $speed == "8_Low-Power_1.0V"} {
        set axis_vid_clk_period_max [expr {5.882353 / $TIMING_MARGIN}]
    } else {
        set axis_vid_clk_period_max [expr {6.666667 / $TIMING_MARGIN}]
    }

    if {$BYTE_STREAM_INTF_EN == "ON"} {
        # Byte stream mode: AXI clock can run up to 187.5 MHz (period 5.333333 ns)
        set axis_vid_clk_period [expr {1000.0 / ($LINE_RATE / $PHY_DATA_WIDTH) / $TIMING_MARGIN}]
    } elseif {$axis_vid_clk_period < $axis_vid_clk_period_max} {
        set axis_vid_clk_period $axis_vid_clk_period_max
    }
    set byte_clk_period         [expr {1000.0 / ($LINE_RATE / $PHY_DATA_WIDTH) / $TIMING_MARGIN}]

    if {$radiant(stage) == "premap"} {
        if {$PHY_MODE == "SOFT_DPHY" && $EDGE_CLOCK_MODE == "INTERNAL"} {
        set_false_path  -to         [get_pins   -hierarchical   {*u_eclkdiv_4data.ECLKDIV_inst/DIVRST}]

        set_false_path  -to         [get_pins   -hierarchical   {*u_reset_sync_word_clk/rstn_sync*[*].ff_inst/LSR}]

        set_false_path  -through    [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_dphy_tx_top/SOFT_DPHY.u_lscc_dphy_tx_soft_top/phy_ready_sync_inst/*dout[*].ff_inst/Q}]

        set_false_path  -through    [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_dphy_tx_top/SOFT_DPHY.u_lscc_dphy_tx_soft_top/phy_ready_sync_inst/*dout*/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_dphy_tx_top/SOFT_DPHY.u_lscc_dphy_tx_soft_top/pll_lock_i_sync_inst/*dout[*].ff_inst/Q}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_dphy_tx_top/SOFT_DPHY.u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/ECLK_ON.u_eclkdiv_4data.ECLKDIV_inst/DIVOUT}]
        }

        set_false_path  -to         [get_pins   -hierarchical   {*u_lscc_lp_hs_dly_ctrl/tinit_done_r*.ff_inst/DF}]

        set_false_path  -to         [get_pins   -hierarchical   {*u_sync_ready/*dout_cc.ff_inst/DF}]

        set_false_path  -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_reset_sync_word_clk/rstn_sync*.ff_inst/LSR}]

        if {$PHY_MODE == "SOFT_DPHY"} {
        set_false_path  -through    [get_pins   -hierarchical   {*u_tx/u_lscc_dphy_tx_top/*u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/ECLK_ON.u_gddr_sync/cs_gddr_sync_reg[0].ff_inst/Q}]
        set_false_path  -through    [get_pins   -hierarchical   {*u_tx/u_lscc_dphy_tx_top/*u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/ECLK_ON.u_gddr_sync/cs_gddr_sync_reg[1].ff_inst/Q}]
        set_false_path  -through    [get_pins   -hierarchical   {*u_tx/u_lscc_dphy_tx_top/*u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/ECLK_ON.u_gddr_sync/ddr_reset_d_reg.ff_inst/Q}]

        set_false_path  -from       [get_pins   -hierarchical   {*u_tx/u_lscc_dphy_tx_top/*u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/*u_gddr_sync/cs_gddr_sync*.ff_inst/Q}]
        set_false_path  -from       [get_pins   -hierarchical   {*u_tx/u_lscc_dphy_tx_top/*u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/*u_gddr_sync/ddr_reset_d*.ff_inst/Q}]

        set_false_path  -to         [get_pins   -hierarchical   {*u_tx/u_lscc_dphy_tx_top/*u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/*u_data_serializer/RST}]
        set_false_path  -to         [get_pins   -hierarchical   {*u_tx/u_lscc_dphy_tx_top/*u_lscc_dphy_tx_soft_top/u_lscc_mipi_dphy_soft_tx/*u_clk_serializer/RST}]

        set_false_path  -from       [get_pins   -hierarchical   {*cs_gddr_sync*/Q}]
        }

        if {$PHY_MODE == "HARD_DPHY"} {
        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_dphy_tx_top/MIXEL_HARD_DPHY.u_lscc_dphy_tx_mixel_top/hs_clk_en_q_reg.ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_dphy_tx_top/MIXEL_HARD_DPHY.u_lscc_dphy_tx_mixel_top/hs_clk_en_r_reg.ff_inst/DF}]
        }

        if {$VIDEO_STREAM_INTF_EN == "ON"} {
        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/u_axis_vid_rst_n_sync/rstn_sync[1].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*u_pixel2byte/u_line_buffer/u_fifo*_dc_*/*u_fifo0/fifo_dc0/_FABRIC.u_fifo/*rd_prev_r.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/u_axis_vid_rst_n_sync/rstn_sync[1].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*u_pixel2byte/u_line_buffer/u_fifo*_dc_*/*u_fifo0/fifo_dc0/_FABRIC.u_fifo/wrst_rdclk_sync_inst/rst_sync*[*].ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/u_axis_vid_rst_n_sync/rstn_sync[1].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*u_pixel2byte/u_line_buffer/u_fifo*_dc_*/*u_fifo0/fifo_dc0/_FABRIC.u_fifo/*.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/u_axis_vid_rst_n_sync/rstn_sync[1].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*u_pixel2byte/u_line_buffer/u_fifo*_dc_*/*u_fifo0/fifo_dc0/_FABRIC.u_fifo/*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/u_axis_vid_rst_n_sync/rstn_sync[1].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*u_pixel2byte/u_line_buffer/u_fifo*_dc_*/*u_fifo0/fifo_dc0/_FABRIC.u_fifo/*/*.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/u_axis_vid_rst_n_sync/rstn_sync[1].ff_inst/Q}] \
