                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/tinit_done*_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/tinit_done*_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*/*.ff_inst/LSR}]

        # Additional false path for wrst_rdclk_sync_inst reset paths (specific to hard DPHY)
        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/tinit_done*_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/wrst_rdclk_sync_inst/*.ff_inst/LSR}]
        
        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/tinit_done*_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/wrst_rdclk_sync_inst/*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/.wp_sync1_r[*].ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/.wp_sync2_r[*].ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*rd_prev_r.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*rd_prev_r.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/*/*.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/wrst_rdclk_sync_inst/*.ff_inst/LSR}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/*skewcal_initial_done_axis_clk_sync_inst/*dout[0].ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/MIPI_CSI_DSI_TX_TOP.u_tx/u_lscc_tx_ctlr/gen_byte_stream_packetizer.u_lscc_packetizer_dphy_byte_stream/u_fifo/*/fifo_dc0/_FABRIC.u_fifo/wrst_rdclk_sync_inst/*.ff_inst/DF}]
        }

        if {$AXI4L_EN == "ON"} {
        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.u_csr/num_line_v_blanking_r*.ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_multibit_*/data_reg0*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.u_csr/num_bytes_per_h_blanking_r*.ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_multibit_*/data_reg0*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.u_csr/num_bytes_active_h_r*.ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_multibit_*/data_reg0*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.u_csr/num_line_active_v_r*.ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_multibit_*/data_reg0*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.u_csr/t_skew_initial_r*.ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_multibit_*/data_reg0*.ff_inst/DF}]

        set_false_path  -from       [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.u_csr/t_skew_periodic_r*.ff_inst/Q}] \
                        -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_multibit_*/data_reg0*.ff_inst/DF}]

        set_false_path  -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_cfg_ready/*dout_cc.ff_inst/DF}]

        set_false_path  -to         [get_pins   -hierarchical   {*lscc_mipi_csi_dsi_top_inst/gen_csr.csr_cdc_tx.u_csr_cdc_tx/u_sync_phy_ready/*dout_cc.ff_inst/DF}]
        }
    }

} else {

    if {$RGB888_ENABLED == "ON"} {
        set BPP 24
    } elseif {$RGB565_ENABLED == "ON"} {
        set BPP 16
    } elseif {$RAW10_ENABLED  == "ON"} {
        set BPP 10
    } else {
        set BPP 12
    }
    
    # Clocks
    set pclk_period             10
    set mipi_refclk_period      [expr {1000.0/$PLL_REF_CLK}]
    set ref_clk_i_period        [expr {1000.0/$SYNCCLK_MHZ}]
    set dphy_clk_period         [expr {2000.0/$LINE_RATE}]
    set clk_byte_period         [expr {$dphy_clk_period*$PHY_DATA_WIDTH/2.0}]
    if {$clk_byte_period > 50} {
        set clk_fr_period       50
    } else {
        set clk_fr_period       $clk_byte_period
    }
    set axis_vid_clk_calc       [expr {$clk_fr_period*$BPP*$PIXELS_PER_CLOCK/$NUM_LANE/$PHY_DATA_WIDTH}]
    if {$axis_vid_clk_calc > $clk_fr_period} {
        set axis_vid_clk_period $clk_fr_period
    } else {
        set axis_vid_clk_period $axis_vid_clk_calc
    }
    
    # Clock Should Be Constrained on Design Top-Level or Inferred from PLL
    #if {$PHY_MODE == "HARD_DPHY"} {
    #    create_clock -name pclk         -period $pclk_period         [get_ports pclk]
    #    create_clock -name mipi_refclk  -period $mipi_refclk_period  [get_ports mipi_refclk_p]
    #} else {
    #    create_clock -name ref_clk      -period $ref_clk_i_period    [get_ports ref_clk_i]
    #}
    #create_clock     -name dphy_clk     -period $dphy_clk_period     [get_ports clk_p_io]
    #create_clock     -name clk_fr       -period $clk_fr_period       [get_ports clk_fr_i]
    #create_clock     -name axis_vid_clk -period $axis_vid_clk_period [get_ports axis_vid_clk_i]
    
    if {$radiant(stage) == "premap"} {
        # Reset Synchronizers
        set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_ref_rst_sync/rstn_sync*}]
        set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*ref_rst_sync*}]
        set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*axis_vid_rst_n_sync*}]
        set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*fr_rst_n_sync*}]
 
        if {$radiant(synthesis) == "synpro"} {
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_fr_rst_n_sync/rstn_sync*}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_axis_vid_rst_n_sync/rstn_sync*}]
        } 

        if {$PHY_MODE == "HARD_DPHY"} {
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_cdphy_rx_hard_top/rst_sync_phy_inst/rstn_sync*}]
        } else {
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/sync_rst_sync/rst_sync*}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/sync_rst_w}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u_clk_byte_reset_n_sync/rstn_sync*}]
        }
        if {$B2P == "ON"} {
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/*u_lscc_byte2pixel/lscc_b2p_core/b2p_byte_reset_sync/rstn_sync*}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/*u_lscc_byte2pixel/lscc_b2p_core/b2p_byte_reset_n}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/*u_lscc_byte2pixel/lscc_b2p_core/b2p_pixel_reset_n}]

            if {$radiant(synthesis) == "synpro"} {
                set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/*u_lscc_byte2pixel/lscc_b2p_core/b2p_pixel_reset_sync/rstn_sync*}]
            } 
        }
        if {$AXI4L_EN == "ON"} {
            set_false_path -from     [get_cells -hierarchical {*gen_csr.csr_cdc_rx.u_csr_cdc_rx*}] \
                           -to       [get_cells -hierarchical {*gen_csr.u_csr*}]
            set_false_path -through  [get_cells -hierarchical {*gen_csr.csr_cdc_rx.u_csr_cdc_rx*}] 
            set_false_path -from     [get_cells -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_rx_ctrl_core*}] \
                           -to       [get_cells -hierarchical {*gen_csr.csr_cdc_rx.u_csr_cdc_rx*}]
            set_false_path -through  [get_nets -hierarchical  {*gen_csr.csr_cdc_rx.u_csr_cdc_rx*/u_pd_dphy_sync/rstn_sync*}]
            set_false_path -through  [get_nets -hierarchical  {*gen_csr.csr_cdc_rx.u_csr_cdc_rx*/pd_dphy_byte_clk}]
            set_false_path -to       [get_pins -hierarchical  {*gen_csr.csr_cdc_rx.u_csr_cdc_rx*/u_pd_dphy_sync/rstn_sync*/LSR}]
        }
        if {$DR_EN == "ON"} {
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/byte_clk_reset_n_sync/rstn_sync*}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/byte_clk_reset_n_w}]
        }
        
        # Asynchronous Signals
        if {$PHY_MODE == "HARD_DPHY"} {
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_cdphy_rx_hard_top/rx_soft_rst_n}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_cdphy_rx_hard_top/rx_soft_shutdown_n}]
            if  {$DR_EN == "ON"} {
                set_false_path -from [get_pins  -hierarchical  {*active_lanes_lmmi_r*.ff_inst/Q}] \
                               -to   [get_cells -hierarchical  {*u_cil_phy_adapter*}]
							   
                set_max_delay -from  [get_pins  -hierarchical  {*lscc_mipi_csi_dsi_top_inst*/*u_rx/*u_dphy_cfg_num_lanes_cdc/*u_lscc_sync/*dout*/Q}] \
                               -to   [get_pins  -hierarchical  {*lscc_mipi_csi_dsi_top_inst*/*u_rx/u_lscc_rx_ctrl_core/*u_rx_adapter/u_cil_phy_adapter/pkt_aligned_reg*/DF}] \
                                     [expr {$clk_byte_period * 0.8}] -datapath_only							   
            }         
        } else {
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_lscc_dphy_rx_io/u0_lscc_dphy_rx_soft/ddr_reset_o}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_lscc_dphy_rx_io/u0_lscc_dphy_rx_soft/u_lscc_gddr_sync/cs_gddr_sync[*]}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_lscc_dphy_rx_io/pll_lock_i}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/lp_rx_p_i*}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/lp_rx_n_i*}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/term_en_*}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/hs_en_o}]
            set_false_path -through [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_word_align/shift_en_d*}]
        }
		
	
        #LP-HS Control Block
        if {$radiant(synthesis) == "synpro"} {
        	set_false_path -from    [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/*c_state*.ff_inst/Q}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_lscc_dphy_rx_io/u0_lscc_dphy_rx_soft/*u_delay_data_line/A}]
        				   
        	set_false_path -from    [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/*c_state*.ff_inst/Q}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*term_d0_en_sync_inst/*dout_cc*/DF}]
        
        	set_false_path -from    [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/*c_state*.ff_inst/Q}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*hs_en_fr_sync_inst/*dout_cc*/DF}]
        
        	set_false_path -from    [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp11_reset_fr_r*}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*hs_en_fr_sync_inst/*dout_cc*/DF}]
        
        	set_false_path -from    [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/lprxn_sync_inst/dout*}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_lscc_dphy_rx_io/u0_lscc_dphy_rx_soft/*u_delay_data_line/A}]
        
        	set_false_path -from    [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/lprxn_sync_inst/*dout*}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*term_d*_en_sync_inst/*dout_cc*/DF}]
            
        	set_false_path -from    [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/lprxn_sync_inst/dout*}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*hs_en_fr_sync_inst/*dout_cc*/DF}]	
 

        } 

        if {$CLK_MODE == "HS_LP"} {
        	set_false_path -from    [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/*c_state*}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_lscc_dphy_rx_io/u0_term_clk_enable_sync/*dout_cc*/DF}]  

        	set_false_path -from    [get_nets -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/lprxn_sync_inst/dout*}] \
        	               -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_lscc_dphy_rx_io/u0_term_clk_enable_sync/*dout_cc_c/DF}]

        	set_false_path -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/lprxp_sync_inst/*dout_cc*/DF}] 
        	
        	set_false_path -to      [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/hs_en_o*/LSR}] 
		
        	set_false_path -through [get_pins -hierarchical {*lscc_mipi_csi_dsi_top*/*u_rx/u_lscc_cdphy_rx_top/*u_lscc_dphy_rx_soft_top/u0_rx_global_ctrl/*lp_hs_ctrl*/hs_en_o*/Q}]
        } 		
	}	
}
