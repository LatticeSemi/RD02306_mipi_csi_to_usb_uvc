set RX_PHY_CSR_LP_0_ITMINRX_REG_CPHY_L1 "0b0001"
set RX_PHY_CSR_LP_0_ITMINRX_REG_CPHY_L2 "0b0001"
set RX_PHY_CSR_LP_2_FILTER_INPUT_SAMPLING_REG_CPHY_L0 "0b0"
