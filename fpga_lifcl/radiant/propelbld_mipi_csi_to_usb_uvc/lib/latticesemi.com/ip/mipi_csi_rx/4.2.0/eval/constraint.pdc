set RX_PHY_CSR_LP_2_OPTIMIZE_TLPX_BTA_REG_CPHY_L1 "0b1"
set RX_PHY_CSR_LP_2_OPTIMIZE_TLPX_BTA_REG_CPHY_L2 "0b1"
set RX_PHY_CSR_HSACTIVERX_DLY_REG_CPHY_L0 "0b01100"
set RX_PHY_CSR_HSACTIVERX_DLY_REG_CPHY_L1 "0b01100"
set RX_PHY_CSR_HSACTIVERX_DLY_REG_CPHY_L2 "0b01100"
set RX_PHY_CSR_IA_LANE0_HSRX_CPHY_CDR_OSC_CLK_OVR_EN "0b0"
set RX_PHY_CSR_IA_LANE2_HSRX_CPHY_CDR_OSC_CLK_OVR_EN "0b0"
set RX_PHY_CSR_IA_LANE3_HSRX_CPHY_CDR_OSC_CLK_OVR_EN "0b0"
set RX_PHY_CSR_IA_LANE0_HSRX_CPHY_CDR_OSC_CLK_OVR_VAL "0b0"
set RX_PHY_CSR_IA_LANE2_HSRX_CPHY_CDR_OSC_CLK_OVR_VAL "0b0"
set RX_PHY_CSR_IA_LANE3_HSRX_CPHY_CDR_OSC_CLK_OVR_VAL "0b0"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG "0b0"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG "0b0"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG_DPHY_L0 "0b0"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG_DPHY_L1 "0b0"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG_DPHY_L2 "0b0"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG_DPHY_L3 "0b0"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG_DPHY_L0 "0b0"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG_DPHY_L1 "0b0"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG_DPHY_L2 "0b0"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG_DPHY_L3 "0b0"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG_CPHY_L0 "0b000"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG_CPHY_L1 "0b000"
set RX_PHY_CSR_CFG_0_LP_PIN_SWAP_REG_CPHY_L2 "0b000"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG_CPHY_L0 "0b0"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG_CPHY_L1 "0b0"
set RX_PHY_CSR_CFG_0_HS_PIN_SWAP_REG_CPHY_L2 "0b0"
set RX_PHY_CSR_OA_LANE0_HSRX_SEL_GATED_POLARITY "0b0"
set RX_PHY_CSR_OA_LANE1_HSRX_SEL_GATED_POLARITY "0b0"
set RX_PHY_CSR_OA_LANE2_HSRX_SEL_GATED_POLARITY "0b0"
set RX_PHY_CSR_OA_LANE3_HSRX_SEL_GATED_POLARITY "0b0"
set RX_PHY_CSR_OA_LANE4_HSRX_SEL_GATED_POLARITY "0b0"
set RX_PHY_CSR_OA_LANE0_HSRX_EQUALIZER "0b100"
set RX_PHY_CSR_OA_LANE1_HSRX_EQUALIZER "0b100"
set RX_PHY_CSR_OA_LANE2_HSRX_EQUALIZER "0b100"
set RX_PHY_CSR_OA_LANE3_HSRX_EQUALIZER "0b100"
set RX_PHY_CSR_OA_LANE4_HSRX_EQUALIZER "0b100"
set RX_PHY_CSR_OA_LANE0_HSRX_DPHY_DLL_CP_PROG "0b000"
set RX_PHY_CSR_OA_LANE1_HSRX_DPHY_DLL_CP_PROG "0b000"
set RX_PHY_CSR_OA_LANE2_HSRX_DPHY_DLL_CP_PROG "0b000"
set RX_PHY_CSR_OA_LANE3_HSRX_DPHY_DLL_CP_PROG "0b000"
set RX_PHY_CSR_OA_LANE4_HSRX_DPHY_DLL_CP_PROG "0b000"

# Virtual IOs
ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {*rst*}]

if {$VIDEO_STREAM_INTF_EN == "ON"} {
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {axis_vid_t*[*]}]
} else {
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {axis_byte_t*[*]}]
}
if {$AXI4L_EN == "ON"} {
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {s_axi_aw*[*]}]
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {s_axi_w*[*]}]
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {s_axi_b*[*]}]
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {s_axi_ar*[*]}]
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {s_axi_r*[*]}]
}

if {$DIR_TYPE == "TX"} {
    # Virtual IOs
    ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {tinit_done_o}]
    if {$BP_ENABLE == "ON"} {
        ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {*blanking_cnt_en_o}]
    }
    if {$PHY_MODE == "SOFT_DPHY"} {
        ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {eclk_ready*}]
        ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {eclk_reset*}]
    }

    ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports axis_vid_clk_i]
    if {$PHY_MODE == "SOFT_DPHY" && $EDGE_CLOCK_MODE == "EXTERNAL"} {
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports pll_clkos_i]
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports byte_clk_i]
    } elseif {$PHY_MODE == "SOFT_DPHY" && $EDGE_CLOCK_MODE == "INTERNAL"} {
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports pll_clkop_i]
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports pll_clkos_i]
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports ref_clk_i]
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports byte_clk_o]
    } else {
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports ref_clk_i]
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports byte_clk_o]
    }
} else {
    ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports ref_clk_i]
    ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports fr_clk_i]
    if {$VIDEO_STREAM_INTF_EN == "ON"} {
        ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports axis_vid_clk_i]
    }
}

set TIMING_MARGIN 1.0

if {$DIR_TYPE == "TX"} {
    # Clock
    set axis_vid_clk_period     [expr {1000.0 / ( ($LINE_RATE * $NUM_LANE) / ($PIXELS_PER_CLOCK * $PIX_WIDTH) )}]
    if {$speed == "9_High-Performance_1.0V" || $speed == "9_Low-Power_1.0V"} {
        set axis_vid_clk_period_max [expr {5.333333}]
    } elseif {$speed == "8_High-Performance_1.0V" || $speed == "8_Low-Power_1.0V"} {
        set axis_vid_clk_period_max [expr {5.882353}]
    } else {
        set axis_vid_clk_period_max [expr {6.666667}]
    }
    if {$BYTE_STREAM_INTF_EN == "ON"} {
        set axis_vid_clk_period [expr {1000.0 / ($LINE_RATE / $PHY_DATA_WIDTH)}]
    } elseif {$axis_vid_clk_period < $axis_vid_clk_period_max} {
        set axis_vid_clk_period $axis_vid_clk_period_max
    }

    if {$AXI4L_EN == "ON"} {
        set axi4l_clk_period    [expr {1000.0 / 60}]
    }
    set ref_clk_period          [expr {1000.0 / $SYNCCLK_MHZ}]
    set pll_clk_period          [expr {2000.0 / $LINE_RATE}]
    set byte_clk_period         [expr {1000.0 / ($LINE_RATE / $PHY_DATA_WIDTH)}]

    set pll_clk_period_scaled   [expr {$pll_clk_period / $TIMING_MARGIN}]
    set pll_clk_shift           [expr {$pll_clk_period_scaled / 4.0}]
    set pll_clk_fall            [expr {$pll_clk_shift + ($pll_clk_period_scaled / 2.0)}]

    create_clock -name axis_vid_clk -period [expr {$axis_vid_clk_period / $TIMING_MARGIN}] [get_ports axis_vid_clk_i]
    if {$AXI4L_EN == "ON"} {
        create_clock -name axi4l_clk    -period [expr {$axi4l_clk_period                    }] [get_ports s_axi_aclk_i]
    }
    if {$PHY_MODE == "SOFT_DPHY" && $EDGE_CLOCK_MODE == "EXTERNAL"} {
        create_clock -name pll_clk_os   -period [expr {$pll_clk_period      / $TIMING_MARGIN}] [get_ports pll_clkos_i]
        create_clock -name byte_clk     -period [expr {$byte_clk_period     / $TIMING_MARGIN}] [get_ports byte_clk_i]
    } elseif {$PHY_MODE == "SOFT_DPHY" && $EDGE_CLOCK_MODE == "INTERNAL"} {
        create_clock -name pll_clk_op   -period [expr {$pll_clk_period      / $TIMING_MARGIN}] [get_ports pll_clkop_i]
        create_clock -name pll_clk_os   -period [expr {$pll_clk_period      / $TIMING_MARGIN}] -waveform [list $pll_clk_shift $pll_clk_fall] [get_ports pll_clkos_i] 
        create_clock -name ref_clk      -period [expr {$ref_clk_period                      }] [get_ports ref_clk_i]
    } elseif {$PHY_MODE == "HARD_DPHY"} {
        create_clock -name ref_clk      -period [expr {$ref_clk_period      / $TIMING_MARGIN}] [get_ports ref_clk_i]
    }
} else {
# Video Format BPP Setting
    if {$RGB888_ENABLED == "ON"} {
        set BPP 24
    } elseif {$RGB565_ENABLED == "ON"} {
        set BPP 16
    } elseif {$RAW10_ENABLED  == "ON"} {
        set BPP 10
    } else {
        set BPP 12
    }

#   Clocks
    set PCLK_PERIOD             10
    set MIPI_REFCLK_PERIOD      [expr {1000.0/$PLL_REF_CLK}]
    set REF_CLK_I_PERIOD        [expr {1000.0/$SYNCCLK_MHZ}]
    set DPHY_CLK_PERIOD         [expr {2000.0/$LINE_RATE}]
    set CLK_BYTE_PERIOD         [expr {$DPHY_CLK_PERIOD*$PHY_DATA_WIDTH/2.0}]
    
    # Check if BYTE_CLK_FREQ is less than 60MHz, free running clock should have minimum frequency of 60MHz.
    if {$CLK_BYTE_PERIOD > 16.66} {
        set CLK_FR_PERIOD       16.66
    } else {
        set CLK_FR_PERIOD       $CLK_BYTE_PERIOD
    }
	
    #set AXIS_VID_CLK_CALC       [expr {($BPP*$PIXELS_PER_CLOCK)/($NUM_LANE/$LINE_RATE)}]
    #if {$AXIS_VID_CLK_CALC > $CLK_BYTE_PERIOD} {
    #    set AXIS_VID_CLK_PERIOD $CLK_BYTE_PERIOD
    #} else {
    #    set AXIS_VID_CLK_PERIOD $AXIS_VID_CLK_CALC
    #}
	
    #Set AXIS_VID_CLK_PERIOD to 5 to obtain 200MHz max value.
    #This can be lower than 200MHz as long as UVSI clock requirement is met.
    set AXIS_VID_CLK_PERIOD 5
	
    #Soft DPHY : Set AXI4L clock frequency to 200MHz max value.
    #Hard DPHY : Set AXI4L clock frequency to 64.935MHz max value.
    set HIPLMMICLK_MHZ_MAX 64.935
    if {$PHY_MODE == "HARD_DPHY"} {
        set AXI4L_CLK_PERIOD   [expr {double(round(1000000/$HIPLMMICLK_MHZ_MAX))/1000}] 
    } else {		
        set AXI4L_CLK_PERIOD  5
    }		
    
#-- Timing performance margin check
#   The 10% margin in fabric clocks is intended solely for evaluation purposes. 
#   In actual project scenarios, it is at your discretion to determine the 
#   appropriate  margin and approach for achieving timing closure, based on 
#   design requirements and constraints.
#   Nexus: 200MHz max fabric speed
    
	set PCLK_PERIOD_MAR                [expr {$PCLK_PERIOD         / $TIMING_MARGIN}]
	set CLK_FR_PERIOD_MAR              [expr {$CLK_FR_PERIOD       / $TIMING_MARGIN}]
	set AXIS_VID_CLK_PERIOD_MAR        [expr {$AXIS_VID_CLK_PERIOD / $TIMING_MARGIN}]
	set AXI4L_CLK_PERIOD_MAR           [expr {$AXI4L_CLK_PERIOD    / $TIMING_MARGIN}]
	if {$PCLK_PERIOD_MAR < 5} {           
	    set PCLK_PERIOD_MAR            5
	}  
	if {$CLK_FR_PERIOD_MAR < 5} {           
	    set CLK_FR_PERIOD_MAR          5
	}                                  
	if {$AXIS_VID_CLK_PERIOD_MAR < 5} {     
	    set AXIS_VID_CLK_PERIOD_MAR    5
	} 
	if {$PHY_MODE == "HARD_DPHY"} {		                                    
	    if {$AXI4L_CLK_PERIOD_MAR < $AXI4L_CLK_PERIOD} {     
	        set AXI4L_CLK_PERIOD_MAR   $AXI4L_CLK_PERIOD
	    }
	} else {			                                    
	    if {$AXI4L_CLK_PERIOD_MAR < 5} {     
	        set AXI4L_CLK_PERIOD_MAR   5
	    }
	}                             

    # Clock Should Be Constrained on Design Top-Level or Inferred from PLL
    #if {$PHY_MODE == "HARD_DPHY"} {
    #    create_clock -name pclk         -period $PCLK_PERIOD_MAR            [get_ports pclk]
    #    create_clock -name mipi_refclk  -period $MIPI_REFCLK_PERIOD         [get_ports mipi_refclk_p]
    #} else {                                                                
        create_clock -name ref_clk      -period $REF_CLK_I_PERIOD           [get_ports ref_clk_i]
    #}    

    if {$AXI4L_EN == "ON"} {
        create_clock -name s_axi_aclk   -period $AXI4L_CLK_PERIOD_MAR       [get_ports s_axi_aclk_i]
    }
	
    create_clock     -name dphy_clk     -period $DPHY_CLK_PERIOD            [get_ports clk_p_io]
    create_clock     -name clk_fr       -period $CLK_FR_PERIOD_MAR          [get_ports fr_clk_i]
    if {$VIDEO_STREAM_INTF_EN == "ON"} {
        create_clock     -name axis_vid_clk -period $AXIS_VID_CLK_PERIOD_MAR    [get_ports axis_vid_clk_i]
    }
}
