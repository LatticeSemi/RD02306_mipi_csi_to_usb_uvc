set device "LIFCL-33U"
set device_int "jd5u27a"
set package "FCCSP104"
set package_int "FCCSP104"
set speed "7_High-Performance_1.0V"
set speed_int "10"
set operation "Commercial"
set family "LIFCL"
set architecture "je5d00"
set partnumber "LIFCL-33U-7CTG104C"
set WRAPPER_INST "ccm_top_inst"
set IP_DIR "./propelbld_mipi_csi_to_usb_uvc/lib/latticesemi_custom/ip/isp_ccm/1.3.1.03"
set FAMILY "LIFCL"
set BITS_PER_PIXEL 8
set PIXELS_PER_CLK 2
set CSR_ENABLE 1
set TX_BUFFER_DEPTH "128"
set CONFIG_UPDATE 1
set TRANSLATION 0
set TRANSLATION_R 0
set TRANSLATION_G 0
set TRANSLATION_B 0
set MRR 0.990000
set MRG 0.000000
set MRB 0.000000
set MGR 0.000000
set MGG 0.990000
set MGB 0.000000
set MBR 0.000000
set MBG 0.000000
set MBB 0.990000
set MRR_FIXED 32440.000000
set MRG_FIXED 0.000000
set MRB_FIXED 0.000000
set MGR_FIXED 0.000000
set MGG_FIXED 32440.000000
set MGB_FIXED 0.000000
set MBR_FIXED 0.000000
set MBG_FIXED 0.000000
set MBB_FIXED 32440.000000
set AXI_STREAM_DATA_WIDTH "48"
set AXI_LITE_ADDR_WIDTH 5
set AXI_LITE_DATA_WIDTH 32


# Update target frequency to pass timing



if {$FAMILY == "LAV-AT" || $FAMILY == "LN2-CT"} {

	set CLOCK_FREQ "200"

} else {

	if {$speed == "9_High-Performance_1.0V"} {

		if {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "145"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "140"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "135"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "145"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "145"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "145"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "150"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "140"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "140"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "145"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "135"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "140"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "150"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "145"

		}

	} elseif {$speed == "8_High-Performance_1.0V"} {

		if {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "135"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "135"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "125"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "135"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "140"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "125"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "130"

		}

	} else {

		if {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "110"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "110"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "115"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "110"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "110"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "110"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "110"

		}

	}

}



set CLOCK_PERIOD [expr {double(round(1000000/$CLOCK_FREQ))/1000}]



create_clock -name {ccm_top_inst/axis_rx_clk_i} -period $CLOCK_PERIOD [get_ports axis_rx_clk_i]

create_clock -name {ccm_top_inst/axis_tx_clk_i} -period $CLOCK_PERIOD [get_ports axis_tx_clk_i]

create_clock -name {axi_lite_clk_i} -period $CLOCK_PERIOD [get_ports axi_lite_clk_i]



# False paths

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/ccm_enable_csr]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/pixel_query_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/line_query_csr*]

set_false_path -from [get_nets ccm_top_inst/stream_rx_dut/blanking_flag]

set_false_path -from [get_nets ccm_top_inst/stream_rx_dut/h_active_stable_sync]

set_false_path -from [get_nets ccm_top_inst/stream_rx_dut/h_blank_stable_sync]

set_false_path -from [get_nets ccm_top_inst/stream_rx_dut/v_blank_stable_sync]

set_false_path -from [get_nets ccm_top_inst/stream_rx_dut/active_horizontal*]

set_false_path -from [get_nets ccm_top_inst/stream_rx_dut/blank_horizontal*]

set_false_path -from [get_nets ccm_top_inst/stream_rx_dut/v_blank_count*]

set_false_path -from [get_nets {ccm_top_inst/stream_rx_dut/rx_tuser_i[0]}]

set_false_path -from [get_nets ccm_top_inst/lin_map_dut/rval_o*]

set_false_path -from [get_nets ccm_top_inst/lin_map_dut/gval_o*]

set_false_path -from [get_nets ccm_top_inst/lin_map_dut/bval_o*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/translation_r_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/translation_g_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/translation_b_csr*]



set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mrr_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mrg_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mrb_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mgr_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mgg_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mgb_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mbr_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mbg_csr*]

set_false_path -from [get_nets ccm_top_inst/genblk1.config_control_dut/mbb_csr*]

