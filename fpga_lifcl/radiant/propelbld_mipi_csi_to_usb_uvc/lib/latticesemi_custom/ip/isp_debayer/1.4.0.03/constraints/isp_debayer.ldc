set device "LIFCL-33U"
set device_int "jd5u27a"
set package "FCCSP104"
set package_int "FCCSP104"
set speed "7_High-Performance_1.0V"
set speed_int "10"
set operation "Commercial"
set family "LIFCL"
set architecture "je5d00"
set partnumber "LIFCL-33U-7CTG104C"
set WRAPPER_INST "debayer_top_inst"
set IP_DIR "./propelbld_mipi_csi_to_usb_uvc/lib/latticesemi_custom/ip/isp_debayer/1.4.0.03"
set FAMILY "LIFCL"
set BITS_PER_PIXEL 10
set ACTIVE_BITS_PER_PIXEL 8
set PIXELS_PER_CLK 2
set PARTIAL_RESOLUTION 0
set HORIZONTAL_SIZE 3280
set CSR_ENABLE 0
set TX_BUFFER_DEPTH "128"
set TX_BUFFER_TYPE "EBR"
set VIDEO_TYPE 1
set BAYER_PATTERN "RGGB"
set CONFIG_DONE 1
set RX_AXI_STREAM_DATA_BUS_WIDTH "32"
set AXI_LITE_ADDR_WIDTH "2"
set AXI_LITE_DATA_WIDTH "32"
set TX_AXI_STREAM_DATA_BUS_WIDTH "48"
set RAM_ADDR_WIDTH "12"


#Update target frequencies to pass timing



if {$FAMILY == "LAV-AT" || $FAMILY == "LN2-CT"} {

	if {$speed == "3"} {

		if {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "250"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "215"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "215"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "215"

		}

	} else {

		if {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "200"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "220"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "210"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "210"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "225"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "215"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "220"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "220"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "225"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "220"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "225"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "215"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "180"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "175"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "200"

		}

	}

} else {

	if {$speed == "9_High-Performance_1.0V"} {

		if {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "160"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "160"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "150"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "160"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "165"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "155"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "160"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "165"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "155"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "170"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "160"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "150"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "155"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "155"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "145"

		}

	} else {

		if {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 6 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "120"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "120"

		} elseif {$BITS_PER_PIXEL == 8 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "120"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 10 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "130"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "125"

		} elseif {$BITS_PER_PIXEL == 12 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "125"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 1} {

			set CLOCK_FREQ "120"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 2} {

			set CLOCK_FREQ "120"

		} elseif {$BITS_PER_PIXEL == 16 && $PIXELS_PER_CLK == 4} {

			set CLOCK_FREQ "100"

		}

	}

}



set CLOCK_PERIOD [expr {double(round(1000000/$CLOCK_FREQ))/1000}]



create_clock -name {debayer_top_inst/axis_rx_clk_i} -period $CLOCK_PERIOD [get_ports axis_rx_clk_i]

create_clock -name {debayer_top_inst/axis_tx_clk_i} -period $CLOCK_PERIOD [get_ports axis_tx_clk_i]

create_clock -name {debayer_top_inst/axi_lite_clk} -period $CLOCK_PERIOD [get_ports axi_lite_clk]



set_false_path -from [get_nets {debayer_top_inst/genblk1.config_control_dut/bayer_pattern_csr[1] debayer_top_inst/genblk1.config_control_dut/bayer_pattern_csr[0]}]

set_false_path -from [get_nets debayer_top_inst/genblk1.config_control_dut/debayer_enable_csr]



set_false_path -through [get_nets debayer_top_inst/active_horizontal*]