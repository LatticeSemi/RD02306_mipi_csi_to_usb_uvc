# Pin Assignments
ldc_set_location -site {E8} [get_ports REFINCLKEXTM_i]
ldc_set_location -site {F8} [get_ports REFINCLKEXTP_i]
ldc_set_location -site {L7} [get_ports cam_en_o]
ldc_set_port -iobuf {IO_TYPE=LVCMOS12H} [get_ports cam_en_o]
ldc_set_location -site {J6} [get_ports cam_scl_z]
ldc_set_port -iobuf {IO_TYPE=LVCMOS12H} [get_ports cam_scl_z]
ldc_set_port -iobuf {PULLMODE=UP CLAMP=ON DIFFRESISTOR=OFF DRIVE=8} [get_ports cam_scl_z]
ldc_set_location -site {H6} [get_ports cam_sda_z]
ldc_set_port -iobuf {IO_TYPE=LVCMOS12H} [get_ports cam_sda_z]
ldc_set_port -iobuf {PULLMODE=UP} [get_ports cam_sda_z]
ldc_set_location -site {H8} [get_ports clk_60m_i]
#ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports clk_60m_i]
ldc_set_location -site {E7} [get_ports dm_z]
ldc_set_port -iobuf {PULLMODE=NONE DRIVE=16} [get_ports dm_z]
ldc_set_location -site {D7} [get_ports dp_z]
ldc_set_port -iobuf {PULLMODE=NONE DRIVE=16} [get_ports dp_z]
ldc_set_location -site {E6} [get_ports rx_clk_n_i]
ldc_set_location -site {F7} [get_ports rx_clk_p_i]
ldc_set_port -iobuf {IO_TYPE=MIPI_DPHY} [get_ports rx_clk_p_i]
ldc_set_location -site {M6} [get_ports rx_d0_n_i]
ldc_set_location -site {M7} [get_ports rx_d0_p_i]
ldc_set_port -iobuf {IO_TYPE=MIPI_DPHY} [get_ports rx_d0_p_i]
ldc_set_location -site {N6} [get_ports rx_d1_n_i]
ldc_set_location -site {N7} [get_ports rx_d1_p_i]
ldc_set_port -iobuf {IO_TYPE=MIPI_DPHY} [get_ports rx_d1_p_i]
ldc_set_location -site {B8} [get_ports u3_rxm_i]
ldc_set_location -site {A8} [get_ports u3_rxp_i]
ldc_set_location -site {A6} [get_ports u3_txm_o]
ldc_set_location -site {A7} [get_ports u3_txp_o]
ldc_set_location -site {F1} [get_ports uart_rxd_i]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports uart_rxd_i]
ldc_set_location -site {G1} [get_ports uart_txd_o]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports uart_txd_o]
ldc_set_location -site {E5} [get_ports vbus_z]

# Design Attributes
ldc_set_sysconfig {CONFIGIO_VOLTAGE_BANK0=1.8 CONFIGIO_VOLTAGE_BANK1=3.3 JTAG_PORT=ENABLE SLAVE_SPI_PORT=DISABLE SLAVE_I3C_PORT=DISABLE SLAVE_I2C_PORT=DISABLE MCCLK_FREQ=75}
ldc_set_vcc -bank 0 1.8
ldc_set_vcc -bank 1 3.3
ldc_set_vcc -bank 2 1.8
ldc_set_vcc -bank 3 1.2
ldc_set_vcc -bank 4 1.8

# Clock Constraints
create_clock -name {clk_60MHz} -period 16.666666 [get_ports clk_60m_i]
create_clock -name {rx_clk_p_i} -period 3.378 [get_ports rx_clk_p_i]

# Timing Constraints
set_false_path -from [get_clocks pll_multiclk_inst_clkos_o_net] -to [get_clocks pll_multiclk_inst_clkos2_o_net]
set_false_path -from [get_clocks pll_multiclk_inst_clkos2_o_net] -to [get_clocks pll_multiclk_inst_clkos_o_net]
set_max_delay -from [get_pins {rs_pixel_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[0]*/Q}] -to [get_pins {rs_pixel_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[1]*/D*}] -datapath_only 8.333
set_max_delay -from [get_pins {rs_pixel_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[0]*/Q}] -to [get_pins {rs_pixel_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[1]*/D*}] -datapath_only 8.333
set_false_path -to [get_pins {rs_pixel_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[*]*/LSR}]
set_false_path -to [get_pins {rs_pixel_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[*]*/LSR}]
set_max_delay -from [get_pins {rs_riscv_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[0]*/Q}] -to [get_pins {rs_riscv_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[1]*/D*}] -datapath_only 13.889
set_max_delay -from [get_pins {rs_riscv_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[0]*/Q}] -to [get_pins {rs_riscv_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[1]*/D*}] -datapath_only 13.889
set_false_path -to [get_pins {rs_riscv_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[*]*/LSR}]
set_false_path -to [get_pins {rs_riscv_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[*]*/LSR}]
set_max_delay -from [get_pins {rs_usb_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[0]*/Q}] -to [get_pins {rs_usb_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[1]*/D*}] -datapath_only 16.667
set_max_delay -from [get_pins {rs_usb_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[0]*/Q}] -to [get_pins {rs_usb_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[1]*/D*}] -datapath_only 16.667
set_false_path -to [get_pins {rs_usb_inst/lscc_reset_inst/*u_lscc_reset_async/rst_sync*[*]*/LSR}]
set_false_path -to [get_pins {rs_usb_inst/lscc_reset_inst/*u_lscc_reset_async/rstn_sync*[*]*/LSR}]
set_false_path -to [get_pins -hierarchical {*RPRST}]
set_false_path -to [get_pins -hierarchical {*RSTW}]

set_clock_uncertainty -setup 0.833 [get_clocks pll_multiclk_inst_clkop_o_net]
set_clock_uncertainty -setup 0.694 [get_clocks pll_multiclk_inst_clkos_o_net]
set_clock_uncertainty -setup 0.416 [get_clocks pll_multiclk_inst_clkos2_o_net]